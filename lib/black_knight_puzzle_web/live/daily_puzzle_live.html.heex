<div class="is-flex is-justify-content-center is-align-items-center">
  <div>
    <div class="container">
      <h1 class="title is-3">Daily Black Knight</h1>
      <p class="subtitle is-5"><%= Calendar.strftime(@daily_puzzle.puzzle_date, "%B %d, %Y") %></p>

      <div class="columns">
        <div class="column">
          <p class="is-size-4">Move: <%= @move || "" %></p>
        </div>
        <div class="column">
          <p class="is-size-4">Count: <%= @move_count || "" %></p>
        </div>
      </div>

      <div id="chess-board" phx-hook="ChessHook">
        <table class="table is-bordered is-striped" style="width: auto;">
          <thead>
            <!-- Column headers -->
            <tr>
              <th></th>
              <%= for col <- ['H', 'G', 'F', 'E', 'D', 'C'] do %>
                <th class="is-size-5"><%= col %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <!-- Rows with data and row labels -->
            <%= for {row_index, row} <- @game_map do %>
              <tr>
                <th class="is-size-5"><%= row_index %></th>
                <%= for {col_index, value} <- Enum.reverse(Map.to_list(row)) do %>
                  <td
                    class={"has-background-" <> chess_color(row_index, col_index, value)}
                    data-row={row_index}
                    data-col={col_index}
                    data-val={value}
                    aria-label={"#{value} on #{col_index}#{row_index}"}
                    style="width: 75px; height: 75px; text-align: center; vertical-align: middle; font-size: 20px;"
                  >
                    <%= if value != 0, do: image_tag(value) %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="container">
      <div class="notification is-light">
        <p class="subtitle is-5">
          Goal: <strong><%= String.upcase(@goal_position) %></strong>. Move the black knight onto today's goal square.
        </p>
        <p class="subtitle is-5">
          Click on a piece to select it, then click on the destination square to move it.
        </p>
        <p class="subtitle is-5">
          Par: <strong><%= @daily_puzzle.solution_length %></strong>
        </p>

        <%= if @won do %>
          <p class="subtitle is-5">
            Solved in <strong><%= @move_count %></strong>.
            <%= if @current_user do %>
              Your score has been saved for today.
            <% else %>
              Sign in to save future daily scores.
            <% end %>
          </p>
        <% end %>

        <%= if @saved_score do %>
          <p class="subtitle is-5">
            Saved score: <strong><%= @saved_score.move_count %></strong>
          </p>
        <% end %>
      </div>
    </div>
  </div>
</div>
