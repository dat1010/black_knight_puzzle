<div class="is-flex is-justify-content-center is-align-items-center">
  <div>
    <table class="table">
      <thead>
        <tr>
          <th>Id</th>
          <th>Status</th>
          <th>Updated At</th>
          <th>Action</th>
        </tr>
      </thead>
      <tfoot>
        <tr>
          <th>Id</th>
          <th>Status</th>
          <th>Inserted At</th>
          <th>Action</th>
        </tr>
      </tfoot>
      <tbody>
        <%= for user_game <- @user_games do %>
          <tr id={"game-#{user_game.id}"}>
            <td><%= user_game.id %></td>
            <td><%= if user_game.won, do: "Won", else: "In progress" %></td>
            <td><%= user_game.updated_at %></td>

            <td>
              <span>
                <.link navigate={~p"/games/#{user_game.id}"}>
                  Show
                </.link>
              </span>
            </td>
            <td></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
